<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_gestion_clinique" model="ir.module.category">
        <field name="name">Gestion Clinique</field>
        <field name="description">Accès aux fonctionnalités de la clinique</field>
        <field name="sequence">10</field>
    </record>

    <!-- ✅ Administrateur — configuration technique uniquement (RG-ACC-03, PV-15) -->
    <record id="group_clinic_admin" model="res.groups">
        <field name="name">Administrateur Clinique</field>
        <field name="category_id" ref="module_category_gestion_clinique"/>
        <field name="comment">Configuration technique, utilisateurs, paramètres. Aucun accès aux données cliniques par défaut.</field>
    </record>

    <record id="group_clinic_reception" model="res.groups">
        <field name="name">Réception</field>
        <field name="category_id" ref="module_category_gestion_clinique"/>
        <field name="implied_ids" eval="[(4, ref('base.group_partner_manager'))]"/>
        <field name="comment">Accès aux patients (identité, contacts), rendez-vous et check-in.</field>
    </record>

    <!-- ✅ Nom corrigé : group_clinic_caisse (pas caissier) — §3.2, PV-10 -->
    <record id="group_clinic_caisse" model="res.groups">
        <field name="name">Caissier</field>
        <field name="category_id" ref="module_category_gestion_clinique"/>
        <field name="comment">Facturation et encaissements. Pas d'accès clinique.</field>
    </record>

    <record id="group_clinic_pharmacie" model="res.groups">
        <field name="name">Pharmacie</field>
        <field name="category_id" ref="module_category_gestion_clinique"/>
        <field name="comment">Ordonnances en lecture, dispensation, stock. Pas de diagnostics.</field>
    </record>

    <record id="group_clinic_infermier" model="res.groups">
        <field name="name">Infirmier(ère)</field>
        <field name="category_id" ref="module_category_gestion_clinique"/>
        <field name="comment">Observations, prélèvements, tâches de suivi.</field>
    </record>

    <record id="group_clinic_medecin" model="res.groups">
        <field name="name">Médecin</field>
        <field name="category_id" ref="module_category_gestion_clinique"/>
        <field name="comment">Consultations, prescriptions, résultats, références.</field>
        <field name="implied_ids" eval="[(4, ref('group_clinic_infermier'))]"/>
    </record>

    <record id="group_clinic_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_gestion_clinique"/>
        <field name="comment">Supervision, approbations, audit, tableau de bord.</field>
    </record>
</odoo>