<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_clinic_patient" model="ir.sequence">
            <field name="name">Identifiant Patient</field>
            <field name="code">clinic.patient</field>
            <field name="prefix">PAT-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_clinic_appointment" model="ir.sequence">
            <field name="name">Référence Rendez-vous</field>
            <field name="code">clinic.appointment</field>
            <field name="prefix">RDV-</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_clinic_visit" model="ir.sequence">
            <field name="name">Référence Visite</field>
            <field name="code">clinic.visit</field>
            <field name="prefix">VIS-</field>
            <field name="padding">5</field>
        </record>
    </data>
</odoo>