<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_patient_tree" model="ir.ui.view">
        <field name="name">gestion.clinique.patient.tree</field>
        <field name="model">gestion.clinique.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="birth_date"/>
                <field name="gender"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="view_patient_form" model="ir.ui.view">
        <field name="name">gestion.clinique.patient.form</field>
        <field name="model">gestion.clinique.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="birth_date"/>
                            <field name="gender"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">gestion.clinique.patient</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_patient" name="Patients"
              parent="menu_gestion_clinique_root"
              action="action_patient" sequence="10"/>
</odoo>
