<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Queue view: only identification + planning data (RG-ACU-02, RG-ACU-04) -->
    <record id="view_clinic_appointment_queue_list" model="ir.ui.view">
        <field name="name">clinic.appointment.queue.list</field>
        <field name="model">clinic.appointment</field>
        <field name="arch" type="xml">
            <list string="File d'attente"
                  create="false"
                  edit="false"
                  delete="false">
                <field name="arrival_time" string="Arrivée"/>
                <field name="name" string="Réf."/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="service"/>
                <field name="date_start" string="Heure prévue"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_clinic_appointment_queue" model="ir.actions.act_window">
        <field name="name">File d'attente</field>
        <field name="res_model">clinic.appointment</field>
        <field name="view_mode">list</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_clinic_appointment_queue_list')})]"/>
        <field name="domain">[('status', '=', 'arrived')]</field>
        <field name="context">{'search_default_filter_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun patient en attente</p>
            <p>Les patients marqués « Arrivé » apparaîtront ici. Aucune information médicale n'est affichée (RG-ACU-02).</p>
        </field>
    </record>

</odoo>