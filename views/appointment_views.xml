<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_appointment_tree" model="ir.ui.view">
        <field name="name">gestion.clinique.appointment.tree</field>
        <field name="model">gestion.clinique.appointment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_appointment_form" model="ir.ui.view">
        <field name="name">gestion.clinique.appointment.form</field>
        <field name="model">gestion.clinique.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="patient_id"/>
                        <field name="doctor_id"/>
                        <field name="appointment_date"/>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">gestion.clinique.appointment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_appointment" name="Appointments"
              parent="menu_gestion_clinique_root"
              action="action_appointment" sequence="30"/>
</odoo>
