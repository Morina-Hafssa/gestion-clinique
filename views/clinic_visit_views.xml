<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_clinic_visit_form" model="ir.ui.view">
        <field name="name">clinic.visit.form</field>
        <field name="model">clinic.visit</field>
        <field name="arch" type="xml">
            <form string="Visite">
                <header>
                    <button name="action_close" type="object"
                            string="Clôturer" class="btn-primary"
                            invisible="status in ('closed', 'cancelled')"/>
                    <button name="action_cancel" type="object"
                            string="Annuler" class="btn-danger"
                            invisible="status in ('closed', 'cancelled')"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id" readonly="1"/>
                            <field name="appointment_id" readonly="1"/>
                            <field name="clinician_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_stop"/>
                        </group>
                    </group>
                    <group string="Notes administratives">
                        <field name="notes" nolabel="1" placeholder="Notes non cliniques..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_clinic_visit_list" model="ir.ui.view">
        <field name="name">clinic.visit.list</field>
        <field name="model">clinic.visit</field>
        <field name="arch" type="xml">
            <list string="Visites">
                <field name="name"/>
                <field name="date_start"/>
                <field name="patient_id"/>
                <field name="clinician_id"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_clinic_visit_search" model="ir.ui.view">
        <field name="name">clinic.visit.search</field>
        <field name="model">clinic.visit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="appointment_id"/>
                <filter name="filter_open" string="Ouvertes" domain="[('status', 'in', ['open', 'in_progress'])]"/>
                <filter name="filter_closed" string="Clôturées" domain="[('status', '=', 'closed')]"/>
                <group expand="0" string="Grouper par">
                    <filter name="group_by_status" string="Statut" context="{'group_by': 'status'}"/>
                    <filter name="group_by_patient" string="Patient" context="{'group_by': 'patient_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_clinic_visit" model="ir.actions.act_window">
        <field name="name">Visites</field>
        <field name="res_model">clinic.visit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_visit_search"/>
    </record>

</odoo>