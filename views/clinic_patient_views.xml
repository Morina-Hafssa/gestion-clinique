<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Consentement : vue liste (named, so Odoo resolves comodel)   -->
    <!-- ============================================================ -->
    <record id="view_clinic_patient_consent_tree" model="ir.ui.view">
        <field name="name">clinic.patient.consent.tree</field>
        <field name="model">clinic.patient.consent</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="consent_type"/>
                <field name="consent_date"/>
                <field name="consent_given"/>
                <field name="consent_withdrawn"/>
                <field name="withdrawal_date" optional="show"/>
                <field name="document_filename" optional="show"/>
                <field name="notes" optional="hide"/>
                <button name="action_withdraw" type="object"
                        string="Retirer" icon="fa-times"
                        invisible="consent_withdrawn or not consent_given"
                        class="btn-link"
                        confirm="Confirmer le retrait de ce consentement ?"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Consentement : vue formulaire                                 -->
    <!-- ============================================================ -->
    <record id="view_clinic_patient_consent_form" model="ir.ui.view">
        <field name="name">clinic.patient.consent.form</field>
        <field name="model">clinic.patient.consent</field>
        <field name="arch" type="xml">
            <form string="Consentement">
                <header>
                    <button name="action_withdraw" type="object"
                            string="Retirer le consentement" class="btn-warning"
                            invisible="consent_withdrawn or not consent_given"
                            confirm="Confirmer le retrait de ce consentement ?"/>
                </header>
                <sheet>
                    <group>
                        <group string="Consentement">
                            <field name="patient_id" readonly="1"/>
                            <field name="consent_type"/>
                            <field name="consent_date"/>
                            <field name="consent_given"/>
                        </group>
                        <group string="Retrait"
                            invisible="not consent_withdrawn">
                            <field name="consent_withdrawn"/>
                            <field name="withdrawal_date"/>
                            <field name="withdrawal_reason"/>
                        </group>
                    </group>
                    <group string="Document signé">
                        <field name="document" filename="document_filename"/>
                        <field name="document_filename" invisible="1"/>
                        <field name="witness_name"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- ===================== FORM ===================== -->
    <record id="view_clinic_patient_form" model="ir.ui.view">
        <field name="name">clinic.patient.form</field>
        <field name="model">clinic.patient</field>
        <field name="arch" type="xml">
            <form string="Dossier Patient">
                <header>
                    <button name="action_verify_identity" type="object"
                            string="Vérifier l'identité" class="btn-primary"
                            invisible="identity_verified"
                            groups="gestion_clinique.group_clinic_reception,gestion_clinique.group_clinic_infermier,gestion_clinique.group_clinic_medecin,gestion_clinique.group_clinic_manager"/>
                    <button name="action_acknowledge_privacy" type="object"
                            string="Enregistrer l'acceptation de la notice" class="btn-secondary"
                            invisible="privacy_notice_acknowledged"
                            groups="gestion_clinique.group_clinic_reception,gestion_clinique.group_clinic_manager"/>
                    <button name="action_open_merge_wizard" type="object"
                            string="Fusionner ce dossier" class="btn-warning"
                            groups="gestion_clinique.group_clinic_manager,gestion_clinique.group_clinic_medecin"
                            confirm="Cette opération est irréversible. Continuer ?"/>
                    <field name="identity_verified" widget="boolean_toggle" readonly="1"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1><field name="patient_identifier" readonly="1"/></h1>
                        <h3><field name="name" placeholder="Nom complet du patient"/></h3>
                    </div>

                    <group>
                        <group string="Identité">
                            <field name="birthdate"/>
                            <field name="birthdate_estimated"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="marital_status"/>
                            <field name="national_id_type"/>
                            <field name="national_id"/>
                        </group>
                        <group string="Contact">
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="zip"/>
                            <field name="country_id"/>
                        </group>
                    </group>

                    <group>
                        <group string="Profil">
                            <field name="occupation"/>
                            <field name="preferred_language"/>
                        </group>
                        <group string="Étiquettes">
                            <field name="tags_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <group>
                        <group string="Contact d'urgence">
                            <field name="emergency_contact_name"/>
                            <field name="emergency_contact_phone" widget="phone"/>
                            <field name="emergency_contact_relation"/>
                        </group>
                        <group string="Assurance">
                            <field name="insurance_provider_id"/>
                            <field name="insurance_number"/>
                            <field name="insurance_valid_until"/>
                            <field name="insurance_coverage_percent"/>
                        </group>
                    </group>

                    <group string="Données cliniques"
                           groups="gestion_clinique.group_clinic_medecin,gestion_clinique.group_clinic_infermier">
                        <field name="blood_group"/>
                        <field name="allergies" placeholder="Allergies connues..."/>
                        <field name="chronic_conditions" placeholder="Maladies chroniques..."/>
                        <field name="current_medications" placeholder="Médicaments en cours..."/>
                        <field name="clinical_notes" placeholder="Notes cliniques confidentielles..."/>
                    </group>

                    <group string="Confidentialité et consentement">
                        <group>
                            <field name="privacy_notice_acknowledged" readonly="1"/>
                            <field name="privacy_notice_date" readonly="1"/>
                        </group>
                        
                    </group>

                    <group string="Traçabilité identité" invisible="not identity_verified">
                        <group>
                            <field name="identity_verified_by_id" readonly="1"/>
                            <field name="identity_verified_at" readonly="1"/>
                        </group>
                    </group>

                    <group string="Notes administratives">
                        <field name="notes" placeholder="Notes visibles par la réception..."/>
                    </group>

                    <notebook>
                        <page string="Consentements" name="consents">
                            <field name="consent_ids" nolabel="1" context="{'default_patient_id': id}">
                                <list editable="bottom">
                                    <field name="consent_type"/>
                                    <field name="consent_date"/>
                                    <field name="consent_given"/>
                                    <field name="consent_withdrawn"/>
                                    <field name="withdrawal_date" optional="show"/>
                                    <field name="document_filename" optional="show"/>
                                    <field name="notes" optional="hide"/>
                                    <button name="action_withdraw" type="object"
                                            string="Retirer" icon="fa-times"
                                            invisible="consent_withdrawn or not consent_given"
                                            class="btn-link"
                                            confirm="Confirmer le retrait de ce consentement ?"/>
                                </list>
                            </field>
                        </page>
                        <page string="Historique" name="history">
                            <group>
                                <field name="create_date" readonly="1"/>
                                <field name="create_uid" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================== TREE ===================== -->
    <record id="view_clinic_patient_tree" model="ir.ui.view">
        <field name="name">clinic.patient.tree</field>
        <field name="model">clinic.patient</field>
        <field name="arch" type="xml">
            <list string="Patients" decoration-info="is_new_patient" decoration-muted="not active">
                <field name="patient_identifier"/>
                <field name="name"/>
                <field name="birthdate"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="insurance_provider_id"/>
                <field name="identity_verified" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"
                       groups="gestion_clinique.group_clinic_manager"/>
            </list>
        </field>
    </record>

    <!-- ===================== SEARCH ===================== -->
    <record id="view_clinic_patient_search" model="ir.ui.view">
        <field name="name">clinic.patient.search</field>
        <field name="model">clinic.patient</field>
        <field name="arch" type="xml">
            <search string="Rechercher un patient">
                <field name="patient_identifier"/>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('name_normalized', 'ilike', self)]"/>
                <field name="phone"/>
                <field name="birthdate"/>
                <field name="national_id"/>
                <field name="insurance_number"/>
                <separator/>
                <filter name="filter_active" string="Actifs" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Archivés" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="filter_identity_verified" string="Identité vérifiée" domain="[('identity_verified', '=', True)]"/>
                <filter name="filter_identity_not_verified" string="Identité non vérifiée" domain="[('identity_verified', '=', False)]"/>
                <separator/>
                <filter name="filter_new_patients" string="Nouveaux patients (7 jours)" domain="[('is_new_patient', '=', True)]"/>
                <group expand="0" string="Grouper par">
                    <filter name="group_by_gender" string="Genre" context="{'group_by': 'gender'}"/>
                    <filter name="group_by_insurance" string="Assureur" context="{'group_by': 'insurance_provider_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================== KANBAN ===================== -->
    <record id="view_clinic_patient_kanban" model="ir.ui.view">
        <field name="name">clinic.patient.kanban</field>
        <field name="model">clinic.patient</field>
        <field name="arch" type="xml">
            <kanban default_group_by="gender" class="o_kanban_small_column">
                <field name="id"/>
                <field name="patient_identifier"/>
                <field name="name"/>
                <field name="age"/>
                <field name="phone"/>
                <field name="identity_verified"/>
                <field name="partner_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div><field name="patient_identifier"/></div>
                                <div><field name="age"/> ans</div>
                                <div><field name="phone"/></div>
                                <div t-if="record.identity_verified.raw_value" class="text-success">
                                    <i class="fa fa-check-circle"/> Identité vérifiée
                                </div>
                                <div t-else="" class="text-warning">
                                    <i class="fa fa-exclamation-triangle"/> Identité non vérifiée
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===================== ACTION ===================== -->
    <record id="action_clinic_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">clinic.patient</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_clinic_patient_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer votre premier dossier patient</p>
            <p>Chaque patient possède un identifiant unique (PAT-00001).
               Vérifiez toujours l'identité avant de lier une consultation ou une facture.</p>
        </field>
    </record>

    <!-- ===================== ACTION : DÉTECTION DOUBLON ===================== -->
    <record id="action_clinic_patient_duplicate_wizard" model="ir.actions.act_window">
        <field name="name">Vérifier les doublons</field>
        <field name="res_model">clinic.patient.duplicate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>