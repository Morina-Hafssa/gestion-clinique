<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_clinic_doctor_list" model="ir.ui.view">
        <field name="name">clinic.doctor.list</field>
        <field name="model">clinic.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialty"/>
                <field name="phone"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_clinic_doctor_form" model="ir.ui.view">
        <field name="name">clinic.doctor.form</field>
        <field name="model">clinic.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="specialty"/>
                            <field name="license_number"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes administratives..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_clinic_doctor" model="ir.actions.act_window">
        <field name="name">Médecins</field>
        <field name="res_model">clinic.doctor</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_clinic_doctor"
              name="Médecins"
              parent="menu_clinic_root"
              action="action_clinic_doctor"
              groups="group_clinic_reception,group_clinic_clinician"
              sequence="20"/>

</odoo>