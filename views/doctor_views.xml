<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doctor_tree" model="ir.ui.view">
        <field name="name">gestion.clinique.doctor.tree</field>
        <field name="model">gestion.clinique.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialty"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="view_doctor_form" model="ir.ui.view">
        <field name="name">gestion.clinique.doctor.form</field>
        <field name="model">gestion.clinique.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="specialty"/>
                        <field name="phone"/>
                        <field name="email"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">gestion.clinique.doctor</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_doctor" name="Doctors"
              parent="menu_gestion_clinique_root"
              action="action_doctor" sequence="20"/>
</odoo>
